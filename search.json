---
layout: null
---
[
{%- assign indexed = site.pages | where_exp: "p", "p.title != nil" -%}
{%- for p in indexed %}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "content": {{ p.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
